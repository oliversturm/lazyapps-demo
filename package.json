{
  "name": "lazyapps-demo",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "scripts": {
    "pnpm-update": "pnpm --recursive update --latest",
    "test:e2e": "./tests/e2e/run.sh",
    "use-branch": "node scripts/use-branch-packages.js",
    "use-released": "node scripts/use-released-packages.js",
    "npmcache": "docker run -d -p 4873:4873 -v ~/.verdaccio/storage:/verdaccio/storage  -v ~/.verdaccio/config:/verdaccio/conf   verdaccio/verdaccio",
    "orch:build": "docker compose -f packages/orchestrated/compose.yml build --no-cache",
    "orch:build:npmcache": "docker compose -f packages/orchestrated/compose.yml -f packages/orchestrated/compose.npm-cache.yml build --no-cache",
    "orch:start": "docker compose -f packages/orchestrated/compose.yml --profile aspire up -d",
    "orch:start:npmcache": "docker compose -f packages/orchestrated/compose.yml -f packages/orchestrated/compose.npm-cache.yml --profile aspire up -d",
    "orch:aspire": "docker compose -f packages/orchestrated/compose.yml --profile aspire up -d",
    "orch:aspire:npmcache": "docker compose -f packages/orchestrated/compose.yml -f packages/orchestrated/compose.npm-cache.yml --profile aspire up -d",
    "orch:grafana": "OTLP_HOST=grafana OTLP_PORT=4317 docker compose -f packages/orchestrated/compose.yml --profile grafana up -d",
    "orch:grafana:npmcache": "OTLP_HOST=grafana OTLP_PORT=4317 docker compose -f packages/orchestrated/compose.yml -f packages/orchestrated/compose.npm-cache.yml --profile grafana up -d",
    "orch:jaeger": "OTLP_HOST=jaeger OTLP_PORT=4317 docker compose -f packages/orchestrated/compose.yml --profile jaeger up -d",
    "orch:jaeger:npmcache": "OTLP_HOST=jaeger OTLP_PORT=4317 docker compose -f packages/orchestrated/compose.yml -f packages/orchestrated/compose.npm-cache.yml --profile jaeger up -d",
    "orch:signoz": "OTLP_HOST=signoz-otel-collector OTLP_PORT=4317 docker compose -f packages/orchestrated/compose.yml --profile signoz up -d",
    "orch:signoz:npmcache": "OTLP_HOST=signoz-otel-collector OTLP_PORT=4317 docker compose -f packages/orchestrated/compose.yml -f packages/orchestrated/compose.npm-cache.yml --profile signoz up -d",
    "orch:down": "docker compose -f packages/orchestrated/compose.yml --profile aspire --profile grafana --profile jaeger --profile signoz down -v",
    "orch:logs": "docker compose -f packages/orchestrated/compose.yml logs -f | pnpm exec log-highlight",
    "mono:start-services": "pnpm --filter @lazyapps/demo-monolith run start-mongo && pnpm --filter @lazyapps/demo-monolith run start-aspire",
    "mono:start": "pnpm --filter @lazyapps/demo-monolith run start-highlight",
    "mono:stop-services": "pnpm --filter @lazyapps/demo-monolith run stop-services"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliversturm/lazyapps-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/oliversturm/lazyapps-demo/issues"
  },
  "homepage": "https://github.com/oliversturm/lazyapps-demo#readme",
  "devDependencies": {
    "@lazyapps/log-highlight": "^0.1.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@lazyapps/admin-api": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/admin-ui": "0.2.0-branch-admin-replay-20260317173929",
      "@lazyapps/aggregatestore-inmemory": "0.2.0-branch-admin-replay-20260317173929",
      "@lazyapps/bootstrap": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/change-notification-sender-fetch": "0.1.3-branch-admin-replay-20260317173929",
      "@lazyapps/change-notifier-socket-io": "0.1.4-branch-admin-replay-20260317173929",
      "@lazyapps/command-processor": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/command-replay": "0.2.0-branch-admin-replay-20260317173929",
      "@lazyapps/command-sender-fetch": "0.1.3-branch-admin-replay-20260317173929",
      "@lazyapps/eventbus-mqemitter-redis": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/eventbus-rabbitmq": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/eventstore-mongodb": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/express": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/mqemitter": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/observability": "0.3.1-branch-admin-replay-20260317173929",
      "@lazyapps/readmodel-backup-mongodb": "0.2.0-branch-admin-replay-20260317173929",
      "@lazyapps/readmodels": "1.0.0-branch-admin-replay-20260317173929",
      "@lazyapps/readmodelstorage-mongodb": "0.2.0-branch-admin-replay-20260317173929"
    }
  }
}
