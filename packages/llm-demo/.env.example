# LLM Service Configuration
#
# LLM_MOCK (default: true)
# When "true", the LLM service uses a built-in mock client that returns
# deterministic, route-aware responses without calling any external API.
# The mock inspects system prompts to detect which feature is calling
# (command generation, reputation, trends, etc.) and returns realistic
# structured data. For RAG/tool-calling, the mock executes real tool
# handlers against actual read model data. Set to any other value (or
# remove) to use the real OpenAI-compatible API.
LLM_MOCK=true

# LLM_API_KEY (required when LLM_MOCK is not "true")
# API key for the OpenAI-compatible LLM provider.
# LLM_API_KEY=sk-...

# LLM_BASE_URL (optional)
# Override the API base URL, e.g. for Azure OpenAI or a local model.
# LLM_BASE_URL=https://api.openai.com/v1

# LLM_MODEL (default: gpt-4o)
# Model identifier to use for completions.
# LLM_MODEL=gpt-4o

# LLM_GENCMD_TOOL_CHOICE (default: required)
# tool_choice for the first request of the command generator.
# "required" forces the model to call a lookup tool first, which prevents
# smaller models (e.g. Mistral Small 3.1) from refusing indirect requests —
# but also forces a lookup where none is needed (e.g. creating a customer).
# "auto" sends no tool_choice and lets the model decide.
# LLM_GENCMD_TOOL_CHOICE=required
