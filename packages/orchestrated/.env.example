# Orchestrated demo — environment variables
#
# Copy to .env and edit for your environment. Docker Compose automatically
# loads `.env` from the same directory as compose.yml for ${VAR}
# interpolation. The values below are the dev defaults previously hardcoded
# in compose.yml; copying this file as-is reproduces the prior behaviour.
#
# .env is gitignored — never commit real secrets. Replace these dev defaults
# with strong values in any non-development deployment.

# --- Vault root token (Vault dev-mode bootstraps with this) ---
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
VAULT_TOKEN=dev-root-token

# --- Keycloak bootstrap admin (created on first start) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- Keycloak service-account client secret ---
# Interpolated into realm-export.json by Keycloak at import time, and used
# by readmodel-orders to fetch service-account tokens. Both sides must
# agree on the value.
SERVICE_CLIENT_SECRET=service-account-secret

# --- Vault AppRole credentials (per service) ---
COMMAND_PROCESSOR_VAULT_ROLE_ID=command-processor-role-id
COMMAND_PROCESSOR_VAULT_SECRET_ID=command-processor-secret-id

READMODEL_CUSTOMERS_VAULT_ROLE_ID=readmodel-customers-role-id
READMODEL_CUSTOMERS_VAULT_SECRET_ID=readmodel-customers-secret-id

READMODEL_ORDERS_VAULT_ROLE_ID=readmodel-orders-role-id
READMODEL_ORDERS_VAULT_SECRET_ID=readmodel-orders-secret-id
