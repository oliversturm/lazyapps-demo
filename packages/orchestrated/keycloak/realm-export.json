      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://svelte.localhost/*",
        "http://react.localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
